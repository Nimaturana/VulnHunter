# Application
APP_NAME=VulnHunter
APP_VERSION=0.1.0
ENVIRONMENT=development
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Persistence (initial integration) and queue (prepared, not wired yet)
DATABASE_URL=postgresql://vulnhunter:vulnhunter@localhost:5432/vulnhunter
REDIS_URL=redis://localhost:6379/0

# Secrets: replace in every non-local environment
SECRET_KEY=change-me
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480

# Keep false outside an isolated local laboratory. This blocks scans against
# localhost, private networks, link-local and other non-public destinations.
ALLOW_PRIVATE_TARGETS=false
VERIFICATION_TIMEOUT_SECONDS=8
VERIFICATION_TOKEN_MINUTES=60
GOOGLE_CLIENT_ID=
GUEST_MODE_ENABLED=false
GUEST_SESSION_MINUTES=60
VITE_GOOGLE_CLIENT_ID=

# Scanner limits for the target-policy implementation phase
MAX_SCAN_TIMEOUT=300
MAX_URLS_PER_SCAN=100
MAX_RESPONSE_BYTES=5242880
CONCURRENT_SCANS=5

# Runtime artifacts
REPORT_DIR=artifacts/reports
