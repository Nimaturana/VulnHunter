# Copy this file to .env.docker. Never commit the real .env.docker file.
API_PORT=8000
FRONTEND_PORT=3000
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET_KEY=Reemplaza_Esto_Con_Un_Secreto_Largo_Y_Aleatorio
ACCESS_TOKEN_MINUTES=480
ALLOW_PRIVATE_TARGETS=false
VERIFICATION_TIMEOUT_SECONDS=8
VERIFICATION_TOKEN_MINUTES=60
GOOGLE_CLIENT_ID=REEMPLAZA_CON_TU_CLIENT_ID.apps.googleusercontent.com
GUEST_MODE_ENABLED=true
GUEST_SESSION_MINUTES=60

# Local development credentials only. Use AWS Secrets Manager in production.
POSTGRES_DB=vulnhunter
POSTGRES_USER=vulnhunter
POSTGRES_PASSWORD=Tu_Contraseña_Aqui
POSTGRES_HOST_PORT=5433
